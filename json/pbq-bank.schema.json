{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giantslayeracademy.example/schemas/pbq-bank.schema.json",
  "title": "Giant Slayer Academy Hydra PBQ Bank",
  "description": "Canonical schema for certification-specific Hydra PBQ Arena banks.",
  "type": "object",
  "required": ["schemaVersion", "certification", "missions"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Hydra PBQ schema version."
    },
    "certification": {
      "type": "string",
      "minLength": 1
    },
    "bankLabel": {
      "type": "string",
      "minLength": 1
    },
    "missions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mission"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mission": {
      "type": "object",
      "required": [
        "id",
        "certification",
        "type",
        "title",
        "objective",
        "difficulty",
        "briefing",
        "instructions",
        "tasks",
        "options",
        "solution",
        "scoring",
        "explanations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "certification": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Renderer registry key."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "briefing": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "options": {
          "description": "Renderer-specific option set. Matching uses an array; configuration-table uses a field-to-options object.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/answerOption"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "solution": {
          "type": "object",
          "minProperties": 1,
          "description": "Task IDs mapped to the canonical answer value or field-value object."
        },
        "scoring": {
          "$ref": "#/$defs/scoring"
        },
        "explanations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Task IDs mapped to original per-task explanations."
        },
        "tableLabel": {
          "type": "string",
          "minLength": 1,
          "description": "Optional accessible caption for configuration-table missions."
        },
        "fieldLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Optional display labels for configuration-table fields."
        },
        "visual": {
          "$ref": "#/$defs/visual",
          "description": "Renderer-neutral visual asset metadata used by visual interaction renderers."
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "prompt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "callout": {
          "$ref": "#/$defs/callout"
        }
      },
      "additionalProperties": true,
      "description": "Renderer-neutral task identity and prompt with optional future renderer metadata."
    },
    "visual": {
      "type": "object",
      "required": ["src", "alt"],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "callout": {
      "type": "object",
      "required": ["label", "x", "y"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "answerOption": {
      "type": "object",
      "required": ["id", "label", "reusable"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "reusable": {
          "type": "boolean",
          "description": "When false, selecting the option for one task makes it unavailable to other tasks."
        }
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "required": ["method", "maxPoints", "partialCredit"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["per-task", "per-field"]
        },
        "maxPoints": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "partialCredit": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
